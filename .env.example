# Database (Neon) — diisi otomatis oleh `npx vercel env pull .env.local`
DATABASE_URL=

# Gemini API — key gratis dari https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Telegram — token dari @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# String acak, dipakai Telegram untuk menandatangani webhook (wajib saat deploy)
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# ID Telegram yang boleh memakai bot, dipisah koma
TELEGRAM_ALLOWED_USER_IDS=
# Akun Telegram itu milik siapa, format id:Nama (nama harus ada di lib/people.ts)
TELEGRAM_USER_PEOPLE=

# Google Sheets — service account yang diberi akses Editor ke spreadsheet
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Password dashboard per orang (harus berbeda). Yang login hanya melihat
# datanya sendiri dan data Kita.
DASHBOARD_PASSWORD_YOR=
DASHBOARD_PASSWORD_AWLAS=

# Claude API (opsional, berbayar) — key dari https://platform.claude.com
# Kalau diisi, Claude membaca pesan lebih dulu dan Gemini jadi cadangan.
ANTHROPIC_API_KEY=

# Opsional
# APP_TIMEZONE=Asia/Jakarta
# EXPENSE_MODEL=gemini-flash-lite-latest

# Token sinkron dari app bagi hasil (cashflowshit), satu per orang yang memakainya
SYNC_TOKEN_YOR=
# Asal browser yang boleh memanggil /api/sync (default https://cashflowshit.vercel.app)
# SYNC_ALLOWED_ORIGINS=
# Alamat app bagi hasil untuk tombol "Cashflowshit" di dashboard (default https://cashflowshit.vercel.app)
# SHARING_APP_URL=
